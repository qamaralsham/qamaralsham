/* 7. الإطار الافتراضي حسب الرتبة (للأفاتار)    */
/* ══════════════════════════════════════════════ */
.avatar-box.default-frame-gold::after {
    content: '';
    position: absolute;
    inset: -4px;
    border-radius: 50%;
    padding: 4px;
    background: conic-gradient(from 0deg, #ffd700, #ffec8b, #fffef0, #ffd700, #d4af37, #b8860b, #ffd700);
    -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    animation: defaultFrameSpin 5s linear infinite;
    pointer-events: none;
    z-index: 5;
    box-shadow: 0 0 20px rgba(255, 215, 0, 0.6);
}
.avatar-box.default-frame-pink::after {
    content: '';
