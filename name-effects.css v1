/* الحلزوني */
@keyframes nfSpiralCW { 0% { background-position: 0% 0%; } 100% { background-position: 100% 100%; } }
@keyframes nfSpiralCCW { 0% { background-position: 100% 100%; } 100% { background-position: 0% 0%; } }
@keyframes nfSpiralPulse { 0%,100% { background-size: 200% 200%; } 50% { background-size: 280% 280%; } }
@keyframes nfSlide { 0% { background-position: 0% 50%; } 100% { background-position: 200% 50%; } }
@keyframes nfSlideFast { 0% { background-position: 0% 50%; } 100% { background-position: 400% 50%; } }

