    padding: 0 10px !important;
    -webkit-background-clip: text !important;
    background-clip: text !important;
    -webkit-text-fill-color: transparent !important;
    color: transparent !important;
    text-shadow: none !important;
    font-weight: 900 !important;
    background-size: 400% 100% !important;
}
.nf-rainbowtext { background-image: linear-gradient(90deg,#ff0000,#ff4400,#ff8800,#ffcc00,#ffff00,#ccff00,#88ff00,#44ff00,#00ff00,#00ff44,#00ff88,#00ffcc,#00ffff,#00ccff,#0088ff,#0044ff,#0000ff,#4400ff,#8800ff,#cc00ff,#ff00ff,#ff00cc,#ff0088,#ff0044,#ff0000) !important; animation: nfSlideFast 2s linear infinite !important; }
