/* ==============================================
   name-effects.css v1 — نظام التأثيرات المركزي
   ==============================================
   ✅ كل تأثير مستقل تماماً
   ✅ خلفية 2px فقط أكبر من النص
   ✅ خلفية خلف النص (لا blur, لا opacity)
   ✅ توهج 1px على حافة الخلفية
   ✅ تعمل في الشات + البروفايل
   ============================================== */

/* ══════════════════════════════════════════════ */
/* الأساس — يُطبَّق على الأسماء في الشات والبروفايل */
/* ══════════════════════════════════════════════ */
:is(.username, .message-username) {
    position: relative;
    display: inline-block;
    padding: 2px 10px;
    line-height: 1.4;
    --name-radius: 999px;
}

/* ══════════════════════════════════════════════ */
/* 1. خلفية الاسم — 2px فقط أكبر من النص          */
/* ══════════════════════════════════════════════ */
:is(.username, .message-username).name-bg-active::before {
    content: '';
    position: absolute;
    inset: -2px;
    border-radius: var(--name-radius);
    background: var(--name-bg, transparent);
    z-index: -1;
    pointer-events: none;
}

/* ══════════════════════════════════════════════ */
/* 2. لون الاسم                                   */
/* ══════════════════════════════════════════════ */
:is(.username, .message-username).name-color-active {
    color: var(--name-color, #fff);
    -webkit-text-fill-color: var(--name-color, #fff);
}

/* ══════════════════════════════════════════════ */
/* 3. تدرج النص                                   */
/* ══════════════════════════════════════════════ */
:is(.username, .message-username).name-gradient-active {
    background-image: var(--name-gradient);
    background-size: 300% 100%;
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    color: transparent;
    animation: nameGradientMove 3s linear infinite;
}

@keyframes nameGradientMove {
    0% { background-position: 0% 50%; }
    100% { background-position: 300% 50%; }
}

/* ══════════════════════════════════════════════ */
/* 4. التوهج — 1px على حافة الخلفية              */
/* ══════════════════════════════════════════════ */
:is(.username, .message-username).name-glow-soft.name-bg-active::before {
    box-shadow: 0 0 1px var(--name-glow-color, #ffd700);
}
:is(.username, .message-username).name-glow-medium.name-bg-active::before {
    box-shadow: 0 0 1px var(--name-glow-color, #ffd700),
                0 0 2px var(--name-glow-color, #ffd700);
}
:is(.username, .message-username).name-glow-strong.name-bg-active::before {
    box-shadow: 0 0 1px var(--name-glow-color, #ffd700),
                0 0 2px var(--name-glow-color, #ffd700),
                0 0 3px var(--name-glow-color, #ffd700);
}

/* التوهج على النص فقط (عند غياب الخلفية) */
:is(.username, .message-username).name-glow-soft:not(.name-bg-active) {
    text-shadow: 0 0 1px var(--name-glow-color, #ffd700);
}
:is(.username, .message-username).name-glow-medium:not(.name-bg-active) {
    text-shadow: 0 0 1px var(--name-glow-color, #ffd700),
                 0 0 2px var(--name-glow-color, #ffd700);
}
:is(.username, .message-username).name-glow-strong:not(.name-bg-active) {
    text-shadow: 0 0 1px var(--name-glow-color, #ffd700),
                 0 0 2px var(--name-glow-color, #ffd700),
                 0 0 4px var(--name-glow-color, #ffd700);
}

/* ══════════════════════════════════════════════ */
/* 5. الأشكال                                     */
/* ══════════════════════════════════════════════ */
:is(.username, .message-username).name-shape-capsule { --name-radius: 999px; padding: 2px 10px; }
:is(.username, .message-username).name-shape-pill    { --name-radius: 20px;  padding: 4px 12px; }
:is(.username, .message-username).name-shape-rounded { --name-radius: 12px;  padding: 4px 12px; }
:is(.username, .message-username).name-shape-square  { --name-radius: 4px;   padding: 4px 10px; }
:is(.username, .message-username).name-shape-ellipse { --name-radius: 50%;   padding: 6px 18px; }

/* ══════════════════════════════════════════════ */
/* 6. إطارات الأسماء (nf-*)                       */
/* ══════════════════════════════════════════════ */
.nf {
    position: relative;
    display: inline-block;
    padding: 2px 10px;
    border-radius: var(--name-radius, 20px);
    color: #fff;
    text-shadow: 0 1px 3px rgba(0,0,0,0.9);
    font-weight: 900;
}

