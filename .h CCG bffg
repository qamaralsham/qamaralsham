<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>شات قمر الشام 👑</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;900&display=swap" rel="stylesheet">
    
    <!-- Firebase SDK -->
    <script src="https://www.gstatic.com/firebasejs/10.7.1/firebase-app-compat.js"></script>
    <script src="https://www.gstatic.com/firebasejs/10.7.1/firebase-auth-compat.js"></script>
    <script src="https://www.gstatic.com/firebasejs/10.7.1/firebase-database-compat.js"></script>
    
    <style>
        :root {
            --bg-dark: #050508;
            --gold: #d4af37;
            --gold-light: #ffd700;
            --text-light: #f3f4f6;
            --text-dim: #9ca3af;
            --border-gold: rgba(212, 175, 55, 0.3);
            --border-light: rgba(255, 255, 255, 0.08);
            --border-input: rgba(255, 255, 255, 0.1);
            --chat-font-size: 16px;
        }
        * { margin: 0; padding: 0; box-sizing: border-box; -webkit-tap-highlight-color: transparent; }
        html, body { width: 100%; height: 100%; height: 100dvh; overflow: hidden; font-family: 'Cairo', sans-serif; background: var(--bg-dark); color: var(--text-light); }
        
        .starfield { position: fixed; inset: 0; z-index: 0; pointer-events: none; overflow: hidden; }
        .starfield .star { position: absolute; width: 2px; height: 2px; background: rgba(255,215,0,0.8); border-radius: 50%; animation: starFall linear infinite; }
        @keyframes starFall { 0% { transform: translateY(-100px); opacity: 0; } 10% { opacity: 1; } 90% { opacity: 1; } 100% { transform: translateY(100vh); opacity: 0; } }
        
        .background-glow { position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: radial-gradient(circle at 50% 0%, rgba(212,175,55,0.1) 0%, transparent 60%); z-index: -1; pointer-events: none; }
        .container { width: 100%; max-width: 500px; height: 100%; height: 100dvh; display: flex; flex-direction: column; position: relative; margin: 0 auto; background: var(--bg-dark); z-index: 1; }
        
        .container.background-type-stars { background-image: url('https://media.giphy.com/media/26tOZ42Mg6pbTUPHW/giphy.gif'); background-size: cover; background-position: center; }
        .container.background-type-nebula { background-image: url('https://media.giphy.com/media/13HgwGsXF0aiGY/giphy.gif'); background-size: cover; background-position: center; }
        .container.background-type-moon { background-image: url('https://media.giphy.com/media/3o7abKhOpu0NwenH3O/giphy.gif'); background-size: cover; background-position: center; }
        .container.background-type-dust { background-image: url('https://media.giphy.com/media/3o7abGQaXGZmJW8HMs/giphy.gif'); background-size: cover; background-position: center; }
        .container.background-type-waves { background-image: url('https://media.giphy.com/media/l0MYt5jPR6QX5pnqM/giphy.gif'); background-size: cover; background-position: center; }
        
        .header { height: 60px; background: rgba(10, 10, 15, 0.95); border-bottom: 1px solid var(--border-gold); display: flex; align-items: center; justify-content: space-between; padding: 0 15px; position: sticky; top: 0; z-index: 100; }
        .room-title { font-size: 13px; font-weight: 700; color: var(--gold-light); }
        .header-actions { display: flex; gap: 8px; }
        .header-btn { width: 36px; height: 36px; border-radius: 10px; border: 1px solid var(--border-gold); background: rgba(20,20,25,0.8); color: #fff; cursor: pointer; display: flex; justify-content: center; align-items: center; font-size: 15px; transition: all 0.2s; }
        .header-btn:active { transform: scale(0.95); }
        
        .mics-bar-wrapper { position: relative; }
        .mics-bar { padding: 8px 12px; background: rgba(5,5,8,0.8); border-bottom: 1px solid var(--border-light); display: flex; align-items: center; gap: 10px; transition: all 0.3s ease; }
        .mics-bar.hidden { display: none; }
        .mics { display: flex; gap: 8px; flex: 1; justify-content: center; }
        .mic-btn { width: 40px; height: 40px; border-radius: 50%; border: 1px solid var(--border-light); background: rgba(255,255,255,0.05); color: #fff; cursor: pointer; font-size: 16px; display: flex; justify-content: center; align-items: center; transition: all 0.3s; }
        .mic-btn.active { background: var(--gold); color: #000; box-shadow: 0 0 15px rgba(212,175,55,0.5); }
        
        .mics-toggle-btn { position: absolute; bottom: -16px; left: 50%; transform: translateX(-50%); width: 32px; height: 20px; border-radius: 0 0 10px 10px; border: 1px solid var(--border-gold); border-top: none; background: rgba(5,5,8,0.9); color: var(--gold); cursor: pointer; font-size: 10px; display: flex; justify-content: center; align-items: center; z-index: 150; transition: all 0.3s; }
        .mics-toggle-btn.hidden { bottom: 0; border-radius: 10px 10px 0 0; border: 1px solid var(--border-gold); border-bottom: none; background: rgba(5,5,8,0.9); }
        
        .messages { flex: 1; padding: 16px; overflow-y: auto; display: flex; flex-direction: column; gap: 16px; background: transparent; scrollbar-width: none; }
        .messages::-webkit-scrollbar { display: none; }
        .message { display: flex; align-items: flex-start; gap: 10px; padding: 0; background: transparent !important; border: none !important; max-width: 100%; animation: fadeInSlide 0.2s ease-out; }
        .message-avatar { width: 38px; height: 38px; border-radius: 50%; object-fit: cover; border: 2px solid var(--gold); flex-shrink: 0; }
        .message-content { flex: 1; display: flex; flex-direction: column; gap: 2px; position: relative; }
        .message-username { font-size: 13px; font-weight: 900; display: flex; align-items: center; gap: 6px; }
        .message-text { font-size: var(--chat-font-size); line-height: 1.4; word-wrap: break-word; }
        .message-time { font-size: 10px; color: var(--text-dim); margin-top: 2px; }
        
        .input-area { padding: 10px 12px; display: flex; align-items: center; gap: 8px; background: rgba(8,8,12,0.95); border-top: 1px solid var(--border-gold); position: relative; z-index: 50; }
        .input-area input { flex: 1; padding: 12px 16px; border-radius: 25px; border: 1px solid var(--border-input); background: rgba(255,255,255,0.05); color: #fff; outline: none; font-family: 'Cairo', sans-serif; font-size: 14px; text-align: right; }
        .input-area input:focus { border-color: var(--gold); }
        .send-btn { width: 40px; height: 40px; border-radius: 50%; border: none; background: var(--gold); color: #000; cursor: pointer; font-size: 16px; display: flex; justify-content: center; align-items: center; box-shadow: 0 4px 10px rgba(212,175,55,0.4); transition: all 0.2s; }
        .emoji-btn { width: 36px; height: 36px; border-radius: 50%; border: none; background: transparent; color: var(--text-dim); cursor: pointer; font-size: 20px; display: flex; justify-content: center; align-items: center; }
        .plus-btn { width: 36px; height: 36px; border-radius: 50%; border: none; background: transparent; color: var(--text-dim); cursor: pointer; font-size: 22px; display: flex; justify-content: center; align-items: center; transition: transform 0.3s; }
        .plus-btn.active { transform: rotate(45deg); }
        
        .floating-toolbar { position: absolute; bottom: 70px; left: 12px; right: 12px; padding: 10px; border-radius: 16px; background: rgba(15,15,20,0.95); border: 1px solid var(--border-gold); display: none; justify-content: space-around; gap: 8px; z-index: 200; }
        .floating-toolbar.open { display: flex; }
        .tool-btn { width: 40px; height: 40px; border-radius: 12px; border: 1px solid var(--border-light); background: rgba(255,255,255,0.04); color: #fff; cursor: pointer; font-size: 18px; display: flex; justify-content: center; align-items: center; }
        
        .bottom-nav { height: 65px; background: rgba(10,10,15,0.95); border-top: 1px solid var(--border-gold); display: flex; justify-content: space-around; align-items: center; }
        .nav-item { display: flex; flex-direction: column; align-items: center; gap: 2px; color: var(--text-dim); cursor: pointer; font-size: 0.65rem; background: none; border: none; padding: 4px; }
        .nav-item i { font-size: 1.1rem; }
        .nav-item.active { color: var(--gold); }
        
        .sidebar { position: fixed; top: 0; width: 60vw; min-width: 200px; max-width: 300px; height: 100%; background: rgba(15,15,20,0.98); border: 1px solid var(--border-gold); box-shadow: 0 0 20px rgba(0,0,0,0.5); transition: transform 0.3s cubic-bezier(0.165, 0.84, 0.44, 1); z-index: 300; display: flex; flex-direction: column; }
        .right-sidebar { right: 0; transform: translateX(100%); }
        .left-sidebar { left: 0; transform: translateX(-100%); }
        .sidebar.open { transform: translateX(0); }
        .sidebar-header { padding: 15px; border-bottom: 1px solid var(--border-gold); display: flex; justify-content: space-between; align-items: center; }
        .sidebar-header h3 { color: var(--gold); font-size: 13px; font-weight: 900; }
        .sidebar-close { width: 30px; height: 30px; border-radius: 8px; border: none; background: rgba(255,255,255,0.05); color: #fff; cursor: pointer; font-size: 14px; }
        .sidebar-content { padding: 12px; display: flex; flex-direction: column; gap: 8px; overflow-y: auto; }
        .sidebar-item { padding: 12px; border-radius: 10px; border: 1px solid var(--border-light); background: rgba(255,255,255,0.03); cursor: pointer; display: flex; align-items: center; gap: 10px; font-size: 13px; font-weight: 600; transition: all 0.2s; }
        .sidebar-item.active { background: var(--gold); color: #000; font-weight: 900; }
        .sidebar-item.locked { opacity: 0.6; cursor: not-allowed; }
        
        .overlay { position: fixed; inset: 0; background: rgba(0,0,0,0.5); backdrop-filter: blur(2px); opacity: 0; pointer-events: none; transition: opacity 0.3s; z-index: 250; }
        .overlay.show { opacity: 1; pointer-events: all; }
        
        /* ====== شاشة الدخول ====== */
        .login-screen { position: fixed; inset: 0; background: rgba(5,5,8,0.98); display: flex; justify-content: center; align-items: center; z-index: 500; overflow-y: auto; padding: 20px; }
        .login-card { width: 100%; max-width: 380px; background: rgba(15,15,20,0.98); border: 1px solid var(--border-gold); border-radius: 20px; padding: 25px; display: flex; flex-direction: column; gap: 15px; box-shadow: 0 20px 50px rgba(0,0,0,0.8); }
        .login-logo { text-align: center; }
        .login-logo i { font-size: 50px; color: var(--gold); }
        .login-logo h1 { font-size: 24px; font-weight: 900; color: var(--gold); margin-top: 8px; }
        .login-logo p { font-size: 12px; color: var(--text-dim); margin-top: 4px; }
        .login-input { padding: 12px; border-radius: 10px; border: 1px solid var(--border-input); background: rgba(255,255,255,0.05); color: #fff; font-family: 'Cairo', sans-serif; outline: none; font-size: 14px; width: 100%; }
        .login-input:focus { border-color: var(--gold); }
        .login-btn { padding: 14px; border-radius: 12px; border: none; background: var(--gold); color: #000; font-weight: 900; font-size: 16px; cursor: pointer; transition: all 0.2s; width: 100%; }
        .login-btn:active { transform: scale(0.98); }
        
        .login-tabs { display: flex; gap: 8px; margin-bottom: 15px; }
        .login-tab { flex: 1; padding: 10px; border-radius: 10px; border: 1px solid var(--border-light); background: rgba(255,255,255,0.03); color: var(--text-dim); cursor: pointer; font-family: 'Cairo', sans-serif; font-size: 13px; font-weight: 700; text-align: center; transition: all 0.2s; }
        .login-tab.active { background: var(--gold); color: #000; border-color: var(--gold); }
        
        .gender-group { display: flex; gap: 10px; }
        .gender-btn { flex: 1; padding: 12px; border-radius: 10px; border: 1px solid var(--border-light); background: rgba(255,255,255,0.03); color: var(--text-dim); cursor: pointer; font-family: 'Cairo', sans-serif; font-size: 14px; font-weight: 700; text-align: center; transition: all 0.2s; }
        .gender-btn.active { background: var(--gold); color: #000; border-color: var(--gold); }
        
        .link-text { color: var(--gold); cursor: pointer; font-size: 13px; text-align: center; text-decoration: underline; }
        
        .toast-notification { position: fixed; top: 20px; right: 20px; background: rgba(15,15,20,0.95); border: 1px solid var(--border-gold); border-radius: 12px; padding: 12px 20px; display: flex; align-items: center; gap: 10px; z-index: 1100; box-shadow: 0 5px 15px rgba(0,0,0,0.5); }
        .toast-notification i { font-size: 20px; color: var(--gold); }
        .toast-notification span { font-size: 13px; font-weight: 600; }
        
        #profile-frame-container { position: fixed; inset: 0; z-index: 9999; background: rgba(0,0,0,0.95); display: none; }
        #profile-frame-container .close-btn { position: absolute; top: 10px; right: 10px; z-index: 10000; background: rgba(255,0,0,0.8); color: #fff; border: none; border-radius: 50%; width: 40px; height: 40px; font-size: 20px; cursor: pointer; }
        #profile-frame-container iframe { width: 100%; height: 100%; border: none; }
        
        @media (max-width: 480px) {
            .sidebar { width: 60vw; min-width: 200px; max-width: 300px; }
            .message-avatar { width: 32px; height: 32px; }
            .message-text { font-size: 14px; }
        }
    </style>
</head>
<body>
    <div class="starfield" id="starfield"></div>
    <div class="background-glow"></div>
    
    <!-- شاشة الدخول -->
    <div class="login-screen" id="login-screen">
        <div class="login-card">
            <div class="login-logo">
                <i class="fas fa-moon"></i>
                <h1>قمر الشام 👑</h1>
                <p>منصة الدردشة الملكية الفاخرة</p>
            </div>
            
            <!-- تبويبات -->
            <div class="login-tabs">
                <button class="login-tab active" id="tab-guest" onclick="switchLoginTab('guest')">
                    <i class="fas fa-user-secret"></i> زائر
                </button>
                <button class="login-tab" id="tab-member" onclick="switchLoginTab('member')">
                    <i class="fas fa-user"></i> عضو
                </button>
            </div>
            
            <!-- نموذج الزائر -->
            <div id="guest-form">
                <input type="text" class="login-input" id="guest-name" placeholder="اسمك..." autocomplete="off" style="margin-bottom:10px;">
                <input type="number" class="login-input" id="guest-age" placeholder="عمرك..." min="1" max="120" style="margin-bottom:10px;">
                <div class="gender-group" style="margin-bottom:10px;">
                    <button class="gender-btn active" id="gender-male" onclick="selectGender('male')">👦 ذكر</button>
                    <button class="gender-btn" id="gender-female" onclick="selectGender('female')">👧 أنثى</button>
                </div>
                <button class="login-btn" onclick="enterAsGuest()">
                    <i class="fas fa-user-secret"></i> دخول كزائر
                </button>
            </div>
            
            <!-- نموذج العضو -->
            <div id="member-form" style="display:none;">
                <input type="email" class="login-input" id="member-email" placeholder="الإيميل..." autocomplete="off" style="margin-bottom:10px;">
                <input type="password" class="login-input" id="member-password" placeholder="كلمة السر..." autocomplete="current-password" style="margin-bottom:10px;">
                <button class="login-btn" onclick="loginAsMember()" style="margin-bottom:10px;">
                    <i class="fas fa-sign-in-alt"></i> تسجيل دخول
                </button>
                <div class="link-text" onclick="switchToRegister()">
                    ليس لديك حساب؟ سجّل الآن
                </div>
            </div>
            
            <!-- نموذج التسجيل -->
            <div id="register-form" style="display:none;">
                <input type="text" class="login-input" id="register-name" placeholder="اسمك..." autocomplete="off" style="margin-bottom:10px;">
                <input type="number" class="login-input" id="register-age" placeholder="عمرك..." min="1" max="120" style="margin-bottom:10px;">
                <div class="gender-group" style="margin-bottom:10px;">
                    <button class="gender-btn active" id="reg-gender-male" onclick="selectRegGender('male')">👦 ذكر</button>
                    <button class="gender-btn" id="reg-gender-female" onclick="selectRegGender('female')">👧 أنثى</button>
                </div>
                <input type="email" class="login-input" id="register-email" placeholder="الإيميل..." autocomplete="off" style="margin-bottom:10px;">
                <input type="password" class="login-input" id="register-password" placeholder="كلمة السر..." autocomplete="new-password" style="margin-bottom:10px;">
                <input type="password" class="login-input" id="register-password-confirm" placeholder="تأكيد كلمة السر..." autocomplete="new-password" style="margin-bottom:10px;">
                <button class="login-btn" onclick="registerNewMember()">
                    <i class="fas fa-user-plus"></i> إنشاء الحساب
                </button>
                <div class="link-text" onclick="switchToLogin()" style="margin-top:10px;">
                    لديك حساب؟ سجّل دخول
                </div>
            </div>
        </div>
    </div>
    
    <!-- الشات -->
    <div class="container" id="chat-container" style="display:none;">
        <div class="header">
            <button class="header-btn" onclick="toggleRooms()"><i class="fas fa-door-open"></i></button>
            <div class="room-title" id="room-title">🌍 الروم العام</div>
            <div class="header-actions">
                <button class="header-btn" onclick="logout()" title="خروج"><i class="fas fa-sign-out-alt"></i></button>
                <button class="header-btn" onclick="toggleSettings()"><i class="fas fa-bars"></i></button>
            </div>
        </div>
        
        <div class="mics-bar-wrapper">
            <div class="mics-bar" id="mics-bar">
                <div class="mics">
                    <button class="mic-btn" onclick="toggleMic(1)"><i class="fas fa-microphone"></i></button>
                    <button class="mic-btn" onclick="toggleMic(2)"><i class="fas fa-microphone"></i></button>
                    <button class="mic-btn" onclick="toggleMic(3)"><i class="fas fa-microphone"></i></button>
                    <button class="mic-btn" onclick="toggleMic(4)"><i class="fas fa-microphone"></i></button>
                </div>
            </div>
            <button class="mics-toggle-btn" id="mics-toggle-btn" onclick="toggleMicsBar()"><i class="fas fa-chevron-up"></i></button>
        </div>
        
        <div class="messages" id="messages">
            <div class="message system" style="background:rgba(212,175,55,0.1); border:1px solid rgba(212,175,55,0.3); border-radius:8px; padding:8px 12px; font-size:12px; color:#ffd700; text-align:center;">👑 أهلاً بك في إمبراطورية قمر الشام</div>
        </div>
        
        <div class="floating-toolbar" id="floating-toolbar">
            <button class="tool-btn" onclick="alert('📁 رفع ملفات')"><i class="fas fa-folder"></i></button>
            <button class="tool-btn" onclick="alert('🎵 تشغيل صوتيات')"><i class="fas fa-music"></i></button>
            <button class="tool-btn" onclick="rollDice()"><i class="fas fa-dice"></i></button>
            <button class="tool-btn" onclick="searchYouTube()"><i class="fas fa-play"></i></button>
            <button class="tool-btn" onclick="alert('🖌️ فرشاة النيون')"><i class="fas fa-paint-brush"></i></button>
            <button class="tool-btn" onclick="alert('🎙️ بصمة صوتية')"><i class="fas fa-wave-square"></i></button>
        </div>
        
        <div class="input-area">
            <button class="send-btn" onclick="sendMessage()"><i class="fas fa-paper-plane"></i></button>
            <button class="emoji-btn" onclick="insertEmoji()"><i class="fas fa-smile"></i></button>
            <input type="text" id="message-input" placeholder="اكتب رسالتك هنا..." onkeypress="handleKeyPress(event)" autocomplete="off">
            <button class="plus-btn" id="plus-btn" onclick="toggleToolbar()"><i class="fas fa-plus"></i></button>
        </div>
        
        <!-- الشريط السفلي: البروفايل أقصى اليمين -->
        <div class="bottom-nav">
            <button class="nav-item" onclick="toggleRooms()"><i class="fas fa-door-open"></i><span>الغرف</span></button>
            <button class="nav-item" onclick="showOnlineUsers()"><i class="fas fa-users"></i><span>المتواجدين</span></button>
            <button class="nav-item" onclick="showFriends()"><i class="fas fa-user-friends"></i><span>الأصدقاء</span></button>
            <button class="nav-item" onclick="showStore()"><i class="fas fa-store"></i><span>المتجر</span></button>
            <button class="nav-item" onclick="toggleSettings()"><i class="fas fa-cog"></i><span>الخيارات</span></button>
            <button class="nav-item" onclick="openProfile()"><i class="fas fa-id-card"></i><span>بروفايلي</span></button>
        </div>
    </div>
    
    <!-- القائمة اليمنى (الرومات) -->
    <div class="sidebar right-sidebar" id="rooms-sidebar">
        <div class="sidebar-header">
            <h3><i class="fas fa-door-open"></i> الغرف</h3>
            <button class="sidebar-close" onclick="closeAllPanels()"><i class="fas fa-times"></i></button>
        </div>
        <div class="sidebar-content">
            <div class="sidebar-item active" onclick="switchRoom('general', '🌍 الروم العام', this)"><i class="fas fa-globe"></i> الروم العام</div>
            <div class="sidebar-item" onclick="switchRoom('quiz', '🎯 روم المسابقات', this)"><i class="fas fa-trophy"></i> روم المسابقات</div>
            <div class="sidebar-item" onclick="switchRoom('islamic', '🕌 روم الإسلاميات', this)"><i class="fas fa-mosque"></i> روم الإسلاميات</div>
            <div class="sidebar-item locked" id="royal-room-item" onclick="switchRoom('royal', '👑 السويت الملكي', this)"><i class="fas fa-crown"></i> السويت الملكي 🔒</div>
            <div class="sidebar-item" onclick="switchRoom('candy', '🍫 كانديز', this)"><i class="fas fa-candy-cane"></i> كانديز</div>
            <div class="sidebar-item" onclick="switchRoom('studio', '🎙️ استديو التسجيل', this)"><i class="fas fa-microphone-alt"></i> استديو التسجيل</div>
            <div class="sidebar-item" onclick="switchRoom('gaza', '🇵🇸 غزة العزة', this)"><i class="fas fa-flag"></i> غزة العزة</div>
            <div class="sidebar-item" onclick="switchRoom('sham', '🌙 ليالي الشام', this)"><i class="fas fa-moon"></i> ليالي الشام</div>
        </div>
    </div>
    
    <!-- القائمة اليسرى (الإعدادات) -->
    <div class="sidebar left-sidebar" id="settings-sidebar">
        <div class="sidebar-header">
            <h3><i class="fas fa-cog"></i> الإعدادات</h3>
            <button class="sidebar-close" onclick="closeAllPanels()"><i class="fas fa-times"></i></button>
        </div>
        <div class="sidebar-content">
            <div class="settings-section">
                <h4 style="color: var(--gold); font-size: 12px; margin-bottom: 8px;">🎨 خلفيات المنصة</h4>
                <div style="display: flex; gap: 8px; flex-wrap: wrap;">
                    <button style="padding: 8px; border-radius: 8px; border: 1px solid var(--border-light); background: rgba(255,255,255,0.05); color: #fff; cursor: pointer;" onclick="changeBackground('stars')">✨ نجوم</button>
                    <button style="padding: 8px; border-radius: 8px; border: 1px solid var(--border-light); background: rgba(255,255,255,0.05); color: #fff; cursor: pointer;" onclick="changeBackground('nebula')">🌌 سديم</button>
                    <button style="padding: 8px; border-radius: 8px; border: 1px solid var(--border-light); background: rgba(255,255,255,0.05); color: #fff; cursor: pointer;" onclick="changeBackground('moon')">🌙 قمر</button>
                    <button style="padding: 8px; border-radius: 8px; border: 1px solid var(--border-light); background: rgba(255,255,255,0.05); color: #fff; cursor: pointer;" onclick="changeBackground('dust')">✨ غبار</button>
                    <button style="padding: 8px; border-radius: 8px; border: 1px solid var(--border-light); background: rgba(255,255,255,0.05); color: #fff; cursor: pointer;" onclick="changeBackground('waves')">🌊 أمواج</button>
                </div>
            </div>
        </div>
    </div>
    
    <div class="overlay" id="overlay" onclick="closeAllPanels()"></div>
    
    <!-- iframe البروفايل -->
    <div id="profile-frame-container">
        <div style="position:relative; width:100%; height:100%;">
            <button class="close-btn" onclick="closeProfileFrame()">✕</button>
            <iframe id="profile-iframe" src="https://qamaralsham.github.io/qamaralsham/profile.html"></iframe>
        </div>
    </div>

    <script>
        // ====== إعدادات Firebase ======
        const firebaseConfig = {
            apiKey: "AIzaSyDOBWW4uACUSShJjwzfpnEzcL3KONZ-6FI",
            authDomain: "qamaralsham.firebaseapp.com",
            databaseURL: "https://qamaralsham-default-rtdb.firebaseio.com",
            projectId: "qamaralsham",
            storageBucket: "qamaralsham.firebasestorage.app",
            messagingSenderId: "1059424590289",
            appId: "1:1059424590289:web:176e82c30c8c7ec4c028f0"
        };
        
        firebase.initializeApp(firebaseConfig);
        const auth = firebase.auth();
        const db = firebase.database();
        
        // ====== المتغيرات ======
        let currentUser = null;
        let currentRoom = 'general';
        let currentBackground = 'stars';
        let selectedGender = 'male';
        let regSelectedGender = 'male';
        let messagesListener = null;
        
        const KING_EMAIL = 'emadhlaweh@gmail.com';
        
        const backgroundsDB = [
            { id: 'stars', class: 'background-type-stars' },
            { id: 'nebula', class: 'background-type-nebula' },
            { id: 'moon', class: 'background-type-moon' },
            { id: 'dust', class: 'background-type-dust' },
            { id: 'waves', class: 'background-type-waves' }
        ];
        
        // ====== التبويبات ======
        function switchLoginTab(tab) {
            document.getElementById('tab-guest').classList.remove('active');
            document.getElementById('tab-member').classList.remove('active');
            
            document.getElementById('guest-form').style.display = 'none';
            document.getElementById('member-form').style.display = 'none';
            document.getElementById('register-form').style.display = 'none';
            
            if (tab === 'guest') {
                document.getElementById('tab-guest').classList.add('active');
                document.getElementById('guest-form').style.display = 'block';
            } else if (tab === 'member') {
                document.getElementById('tab-member').classList.add('active');
                document.getElementById('member-form').style.display = 'block';
            }
        }
        
        function switchToRegister() {
            document.getElementById('member-form').style.display = 'none';
            document.getElementById('register-form').style.display = 'block';
        }
        
        function switchToLogin() {
            document.getElementById('register-form').style.display = 'none';
            document.getElementById('member-form').style.display = 'block';
        }
        
        function selectGender(gender) {
            selectedGender = gender;
            document.getElementById('gender-male').classList.remove('active');
            document.getElementById('gender-female').classList.remove('active');
            if (gender === 'male') document.getElementById('gender-male').classList.add('active');
            else document.getElementById('gender-female').classList.add('active');
        }
        
        function selectRegGender(gender) {
            regSelectedGender = gender;
            document.getElementById('reg-gender-male').classList.remove('active');
            document.getElementById('reg-gender-female').classList.remove('active');
            if (gender === 'male') document.getElementById('reg-gender-male').classList.add('active');
            else document.getElementById('reg-gender-female').classList.add('active');
        }
        
        // ====== دخول الزائر ======
        function enterAsGuest() {
            const name = document.getElementById('guest-name').value.trim();
            const age = document.getElementById('guest-age').value.trim();
            
            if (!name) { alert('⚠️ الرجاء إدخال الاسم'); return; }
            if (!age || age < 1 || age > 120) { alert('⚠️ الرجاء إدخال عمر صحيح'); return; }
            
            currentUser = {
                name, age, gender: selectedGender,
                rank: 'Guest', email: null,
                color: '#95a5a6',
                avatar: `https://ui-avatars.com/api/?name=${encodeURIComponent(name)}&background=95a5a6&color=fff`,
                isGuest: true, uid: null
            };
            
            localStorage.setItem('qamar_guest', JSON.stringify(currentUser));
            enterChat();
        }
        
        // ====== دخول العضو ======
        async function loginAsMember() {
            const email = document.getElementById('member-email').value.trim().toLowerCase();
            const password = document.getElementById('member-password').value;
            
            if (!email || !password) { alert('⚠️ الرجاء إدخال الإيميل وكلمة السر'); return; }
            
            try {
                const userCredential = await auth.signInWithEmailAndPassword(email, password);
                const user = userCredential.user;
                
                const snapshot = await db.ref('users/' + user.uid).once('value');
                const userData = snapshot.val();
                
                if (userData) {
                    currentUser = { ...userData, uid: user.uid, email: email, isGuest: false };
                } else {
                    currentUser = {
                        name: email.split('@')[0], email,
                        rank: (email === KING_EMAIL) ? 'King' : 'User',
                        color: '#ffffff',
                        avatar: `https://ui-avatars.com/api/?name=${encodeURIComponent(email)}&background=random&color=fff`,
                        uid: user.uid, isGuest: false
                    };
                }
                
                localStorage.setItem('qamar_user', JSON.stringify(currentUser));
                localStorage.removeItem('qamar_guest');
                enterChat();
                
            } catch (error) {
                console.error(error);
                if (error.code === 'auth/user-not-found') alert('⚠️ الحساب غير موجود');
                else if (error.code === 'auth/wrong-password') alert('⚠️ كلمة السر غير صحيحة');
                else if (error.code === 'auth/invalid-credential') alert('⚠️ البيانات غير صحيحة');
                else alert('❌ خطأ: ' + error.message);
            }
        }
        
        // ====== تسجيل عضو جديد ======
        async function registerNewMember() {
            const name = document.getElementById('register-name').value.trim();
            const age = document.getElementById('register-age').value.trim();
            const email = document.getElementById('register-email').value.trim().toLowerCase();
            const password = document.getElementById('register-password').value;
            const confirmPassword = document.getElementById('register-password-confirm').value;
            
            if (!name || !age || !email || !password || !confirmPassword) {
                alert('⚠️ الرجاء إدخال جميع الحقول'); return;
            }
            if (password !== confirmPassword) { alert('⚠️ كلمات السر غير متطابقة'); return; }
            if (password.length < 6) { alert('⚠️ كلمة السر 6 أحرف على الأقل'); return; }
            
            try {
                const userCredential = await auth.createUserWithEmailAndPassword(email, password);
                const user = userCredential.user;
                
                const rank = (email === KING_EMAIL) ? 'King' : 'User';
                
                await db.ref('users/' + user.uid).set({
                    name, email, age, gender: regSelectedGender, rank,
                    color: rank === 'King' ? '#ffd700' : '#ffffff',
                    avatar: `https://ui-avatars.com/api/?name=${encodeURIComponent(name)}&background=random&color=fff`,
                    createdAt: firebase.database.ServerValue.TIMESTAMP
                });
                
                currentUser = {
                    name, age, gender: regSelectedGender, email, rank,
                    color: rank === 'King' ? '#ffd700' : '#ffffff',
                    avatar: `https://ui-avatars.com/api/?name=${encodeURIComponent(name)}&background=random&color=fff`,
                    uid: user.uid, isGuest: false
                };
                
                localStorage.setItem('qamar_user', JSON.stringify(currentUser));
                localStorage.removeItem('qamar_guest');
                
                showToast('fa-crown', '🎉 مرحباً بك عضواً');
                enterChat();
                
            } catch (error) {
                console.error(error);
                if (error.code === 'auth/email-already-in-use') alert('⚠️ الإيميل مستخدم');
                else if (error.code === 'auth/invalid-email') alert('⚠️ الإيميل غير صحيح');
                else if (error.code === 'auth/weak-password') alert('⚠️ كلمة السر ضعيفة');
                else alert('❌ خطأ: ' + error.message);
            }
        }
        
        // ====== الدخول للشات ======
        function enterChat() {
            document.getElementById('login-screen').style.display = 'none';
            document.getElementById('chat-container').style.display = 'flex';
            
            const savedBg = localStorage.getItem('qamar_background');
            if (savedBg) changeBackground(savedBg);
            
            generateStars();
            
            if (currentUser.rank === 'King') {
                document.getElementById('royal-room-item').classList.remove('locked');
                document.getElementById('royal-room-item').innerHTML = '<i class="fas fa-crown"></i> السويت الملكي';
            }
            
            addSystemMessage(`👑 مرحباً ${currentUser.name}`);
            showToast('fa-crown', `مرحباً ${currentUser.name}`);
            
            startMessagesListener();
        }
        
        // ====== الاستماع للرسائل ======
        function startMessagesListener() {
            if (messagesListener) messagesListener.off();
            
            const messagesRef = db.ref('rooms/' + currentRoom + '/messages');
            messagesListener = messagesRef.limitToLast(100);
            messagesListener.on('child_added', (snapshot) => {
                const msg = snapshot.val();
                if (msg) {
                    addMessageWithAvatar(msg.sender, msg.text, msg.color, msg.avatar, msg.time);
                }
            });
        }
        
        // ====== إرسال رسالة ======
        function sendMessage() {
            const input = document.getElementById('message-input');
            const text = input.value.trim();
            
            if (!text) return;
            if (isLink(text)) { alert('⚠️ يحظر نشر الروابط'); return; }
            
            db.ref('rooms/' + currentRoom + '/messages').push({
                sender: currentUser.name,
                text: text,
                time: firebase.database.ServerValue.TIMESTAMP,
                avatar: currentUser.avatar,
                color: currentUser.color,
                uid: currentUser.uid || null
            });
            
            input.value = '';
            input.focus();
        }
        
        function isLink(text) {
            return /(https?:\/\/|www\.|\.com)/i.test(text);
        }
        
        function handleKeyPress(e) {
            if (e.key === 'Enter') sendMessage();
        }
        
        // ====== إضافة رسالة ======
        function addMessageWithAvatar(sender, text, color, avatar, time) {
            const messagesContainer = document.getElementById('messages');
            const msg = document.createElement('div');
            msg.className = 'message';
            msg.setAttribute('data-sender', sender);
            
            const avatarImg = document.createElement('img');
            avatarImg.className = 'message-avatar';
            avatarImg.src = avatar || `https://ui-avatars.com/api/?name=${encodeURIComponent(sender)}&background=random&color=fff`;
            avatarImg.alt = sender;
            
            const content = document.createElement('div');
            content.className = 'message-content';
            
            const username = document.createElement('div');
            username.className = 'message-username';
            username.style.color = color || '#ffd700';
            username.innerText = sender;
            
            const msgText = document.createElement('div');
            msgText.className = 'message-text';
            msgText.innerText = text;
            
            const timeEl = document.createElement('div');
            timeEl.className = 'message-time';
            timeEl.innerText = time ? new Date(time).toLocaleTimeString('ar', { hour: '2-digit', minute: '2-digit' }) : new Date().toLocaleTimeString('ar', { hour: '2-digit', minute: '2-digit' });
            
            content.appendChild(username);
            content.appendChild(msgText);
            content.appendChild(timeEl);
            
            msg.appendChild(avatarImg);
            msg.appendChild(content);
            
            messagesContainer.appendChild(msg);
            messagesContainer.scrollTop = messagesContainer.scrollHeight;
        }
        
        function addSystemMessage(text) {
            const messagesContainer = document.getElementById('messages');
            const msg = document.createElement('div');
            msg.className = 'message system';
            msg.style.cssText = 'background:rgba(212,175,55,0.1); border:1px solid rgba(212,175,55,0.3); border-radius:8px; padding:8px 12px; font-size:12px; color:#ffd700; text-align:center;';
            msg.innerText = text;
            messagesContainer.appendChild(msg);
            messagesContainer.scrollTop = messagesContainer.scrollHeight;
        }
        
        // ====== النجوم ======
        function generateStars() {
            const starfield = document.getElementById('starfield');
            starfield.innerHTML = '';
            for (let i = 0; i < 50; i++) {
                const star = document.createElement('div');
                star.className = 'star';
                star.style.left = Math.random() * 100 + '%';
                star.style.animationDuration = (Math.random() * 3 + 2) + 's';
                star.style.animationDelay = (Math.random() * 5) + 's';
                starfield.appendChild(star);
            }
        }
        
        function changeBackground(backgroundId) {
            const container = document.getElementById('chat-container');
            const bg = backgroundsDB.find(b => b.id === backgroundId);
            if (bg) {
                container.classList.remove('background-type-stars', 'background-type-nebula', 'background-type-moon', 'background-type-dust', 'background-type-waves');
                container.classList.add(bg.class);
                currentBackground = backgroundId;
                localStorage.setItem('qamar_background', backgroundId);
            }
        }
        
        // ====== الغرف ======
        function switchRoom(roomId, roomTitle, element) {
            if (roomId === 'royal' && currentUser.rank !== 'King' && currentUser.rank !== 'Queen') {
                alert('🔒 هذا الروم خاص جداً'); return;
            }
            if (roomId === 'studio' && currentUser.isGuest) {
                alert('🎙️ استديو التسجيل غير متاح للزوار'); return;
            }
            
            if (messagesListener) messagesListener.off();
            
            currentRoom = roomId;
            document.getElementById('room-title').innerText = roomTitle;
            
            document.querySelectorAll('.sidebar-item').forEach(item => item.classList.remove('active'));
            if (element) element.classList.add('active');
            
            document.getElementById('messages').innerHTML = '';
            addSystemMessage(`📢 تم فتح ${roomTitle}`);
            
            startMessagesListener();
            closeAllPanels();
        }
        
        // ====== القوائم ======
        function toggleRooms() {
            document.getElementById('rooms-sidebar').classList.toggle('open');
            document.getElementById('overlay').classList.toggle('show');
        }
        
        function toggleSettings() {
            document.getElementById('settings-sidebar').classList.toggle('open');
            document.getElementById('overlay').classList.toggle('show');
        }
        
        function closeAllPanels() {
            document.getElementById('rooms-sidebar').classList.remove('open');
            document.getElementById('settings-sidebar').classList.remove('open');
            document.getElementById('overlay').classList.remove('show');
        }
        
        // ====== البروفايل ======
        function openProfile() {
            localStorage.setItem('qamar_user_data', JSON.stringify(currentUser));
            document.getElementById('profile-frame-container').style.display = 'block';
        }
        
        function closeProfileFrame() {
            document.getElementById('profile-frame-container').style.display = 'none';
            const iframe = document.getElementById('profile-iframe');
            iframe.src = iframe.src;
        }
        
        // ====== المايكات ======
        function toggleMic(micNum) {
            const mic = document.querySelectorAll('.mic-btn')[micNum - 1];
            mic.classList.toggle('active');
            mic.innerHTML = mic.classList.contains('active') ? '<i class="fas fa-user"></i>' : '<i class="fas fa-microphone"></i>';
        }
        
        function toggleMicsBar() {
            const micsBar = document.getElementById('mics-bar');
            const toggleBtn = document.getElementById('mics-toggle-btn');
            micsBar.classList.toggle('hidden');
            toggleBtn.classList.toggle('hidden');
            toggleBtn.innerHTML = micsBar.classList.contains('hidden') ? '<i class="fas fa-chevron-down"></i>' : '<i class="fas fa-chevron-up"></i>';
        }
        
        // ====== أدوات ======
        function toggleToolbar() {
            document.getElementById('floating-toolbar').classList.toggle('open');
            document.getElementById('plus-btn').classList.toggle('active');
        }
        
        document.addEventListener('click', function(e) {
            const toolbar = document.getElementById('floating-toolbar');
            const plusBtn = document.getElementById('plus-btn');
            if (toolbar.classList.contains('open') && !toolbar.contains(e.target) && !plusBtn.contains(e.target)) {
                toolbar.classList.remove('open');
                plusBtn.classList.remove('active');
            }
        });
        
        function rollDice() { addSystemMessage(`🎲 النرد: ${Math.floor(Math.random() * 6) + 1}`); }
        function searchYouTube() {
            const query = prompt('🔍 ابحث في يوتيوب:');
            if (query) window.open(`https://www.youtube.com/results?search_query=${encodeURIComponent(query)}`, '_blank');
        }
        function insertEmoji() {
            const input = document.getElementById('message-input');
            input.value += '😊';
            input.focus();
        }
        
        function showOnlineUsers() { closeAllPanels(); alert('👥 المتواجدين'); }
        function showFriends() { closeAllPanels(); alert('👥 قيد التطوير'); }
        function showStore() { closeAllPanels(); alert('🛒 قيد التطوير'); }
        
        // ====== الإشعارات ======
        function showToast(icon, message) {
            const toast = document.createElement('div');
            toast.className = 'toast-notification';
            toast.innerHTML = `<i class="fas ${icon}"></i><span>${message}</span>`;
            document.body.appendChild(toast);
            setTimeout(() => toast.remove(), 3000);
        }
        
        // ====== الخروج ======
        function logout() {
            if (confirm('هل أنت متأكد من الخروج؟')) {
                localStorage.removeItem('qamar_user');
                localStorage.removeItem('qamar_guest');
                
                if (messagesListener) messagesListener.off();
                if (currentUser && !currentUser.isGuest) auth.signOut();
                
                document.getElementById('chat-container').style.display = 'none';
                document.getElementById('login-screen').style.display = 'flex';
                document.getElementById('guest-name').value = '';
                document.getElementById('guest-age').value = '';
                document.getElementById('member-email').value = '';
                document.getElementById('member-password').value = '';
                
                currentUser = null;
                closeAllPanels();
                closeProfileFrame();
            }
        }
        
        // ====== تحميل البيانات ======
        window.addEventListener('DOMContentLoaded', () => {
            const savedUser = localStorage.getItem('qamar_user');
            const savedGuest = localStorage.getItem('qamar_guest');
            
            if (savedUser) {
                currentUser = JSON.parse(savedUser);
                enterChat();
            } else if (savedGuest) {
                currentUser = JSON.parse(savedGuest);
                enterChat();
            }
        });
    </script>
</body>
</html>
